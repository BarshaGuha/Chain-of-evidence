# Copy to .env and fill in. Never commit .env.
# Set SAMPLE_MODE=true to run with no credentials (bundled CSVs + offline reasoner).
SAMPLE_MODE=false

# Power: Nemotron via Meterless Nightshift (Console -> Runtime URL and API key)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Data: Zetaris REST API (local install)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# The name each source system was registered under in Zetaris (Data Explorer).
# Queries address tables as <source>.<table>, e.g. scm_wms.stockout_events.
ZETARIS_SOURCE_ORDERS=scm_orders
ZETARIS_SOURCE_PLANNING=scm_planning
ZETARIS_SOURCE_WMS=scm_wms
ZETARIS_SOURCE_FINANCE=scm_finance
